# Copy this file to .env and fill in your own values.

# Either set DATABASE_URL, or the individual DB_* fields below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eswama_waste

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eswama_waste

# Use a long, random string in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=4000

# The URL of the running frontend, for CORS and Socket.IO.
CLIENT_ORIGIN=http://localhost:5173
